# ---------- 应用 ----------
APP_PORT=3000
APP_GLOBAL_PREFIX=api/v1
NODE_ENV=development

# ---------- 数据库 ----------
# 本地无 Docker 调试/单测：DB_TYPE=sqlite（sql.js 内存库，零依赖，启动即用）
# 生产/联调：DB_TYPE=mysql
DB_TYPE=sqlite

# MySQL 8（DB_TYPE=mysql 时生效）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root123456
DB_DATABASE=jigouman
DB_SYNCHRONIZE=true   # 开发期自动建表；生产改为 false 并走 migration
DB_LOGGING=false

# ---------- 缓存 (Redis 7) ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_TTL=3600

# ---------- JWT ----------
JWT_SECRET=please-change-me-in-prod
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ---------- 多租户 ----------
# 默认租户(单库多租户: 按 tenant_id 隔离)，真实环境由登录态/网关注入
DEFAULT_TENANT_ID=100000
