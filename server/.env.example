# ---------- 应用 ----------
APP_PORT=3000
APP_GLOBAL_PREFIX=api/v1
NODE_ENV=development

# ---------- 数据库 ----------
# 本地无 Docker 调试/单测：DB_TYPE=sqlite（better-sqlite3 原生驱动，需 Node 22）
# 生产/联调：DB_TYPE=mysql
DB_TYPE=sqlite
# SQLite 库位置：:memory: 为内存库(默认，重启清空)；指定路径则落盘，便于本地调试查看数据
DB_SQLITE_PATH=:memory:

# MySQL 8（DB_TYPE=mysql 时生效）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root123456
DB_DATABASE=jigouman
DB_SYNCHRONIZE=true   # 开发期自动建表；生产改为 false 并走 migration
DB_LOGGING=false

# ---------- 缓存 (Redis 7) ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_TTL=3600

# ---------- JWT ----------
JWT_SECRET=please-change-me-in-prod
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ---------- 多租户 ----------
# 默认租户(单库多租户: 按 tenant_id 隔离)，真实环境由登录态/网关注入
DEFAULT_TENANT_ID=100000

# ---------- 统一资源存储（本地 / OSS 可切换） ----------
# STORAGE_TYPE=local 时文件存于 UPLOAD_DIR，经 http://HOST/files/* 访问
# STORAGE_TYPE=oss 时走阿里云 OSS（需先 npm i ali-oss，并配置下方 OSS_*）
STORAGE_TYPE=local
UPLOAD_DIR=uploads
# 本地文件公开基础 URL（生成资源访问地址用，默认取 APP_PORT）
PUBLIC_BASE_URL=http://localhost:3000

# OSS 配置（STORAGE_TYPE=oss 时必填）
# OSS_REGION=cn-hangzhou
# OSS_BUCKET=your-bucket
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com   # 可选：自定义/内网域名，启用 cname
# OSS_BASE_URL=https://your-cdn.com            # 可选：Bucket 公共读/CDN 基础 URL
# OSS_DIR=jigouman                              # 可选：key 前缀目录
